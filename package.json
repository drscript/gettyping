  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.18"
